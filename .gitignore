.DS_Store

# HACHIKO web app
node_modules
/dist
*.tsbuildinfo

# Large binaries fetched locally per public/*/README.md - never committed
public/wasm/
public/models/*.task
public/models/*.tflite
# Generated by tools/copy-wasm.mjs from node_modules, like public/wasm/.
# Pinned by package-lock.json rather than by being committed.
public/vendor/
public/fonts/*.woff2
public/fonts/*.woff
public/fonts/*.ttf

# Session telemetry exports if ever saved into the repo by mistake
*.jsonl
!fixtures/*.jsonl
.superpowers/

# Raw mascot art exports (108MB, uncropped sticker sheets) - the actual
# cropped/optimized art the app uses lives in public/mascot/ and IS
# committed; this is just the source material, kept locally only.
/assets/
